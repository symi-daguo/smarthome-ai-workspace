verify-deps-before-run=false
strict-peer-dependencies=false

# ===== registry：刻意不在此固定 =====
# 默认走官方源 https://registry.npmjs.org（CI 与海外部署的正确选择）。
# 国内网络需要镜像时，不要改这里（会污染所有部署者），而是构建时传参：
#   NPM_REGISTRY=https://registry.npmmirror.com/ docker compose build
# Dockerfile 里的 `ARG NPM_REGISTRY` 接收该变量，compose 通过 ${NPM_REGISTRY:-} 透传。
# 本机 ~/.npmrc 的 registry 只对本机生效，不进镜像——这正是原先容器构建偶发失败的原因。

# ===== 网络健壮性 =====
# registry 抖动（error 23 / ECONNRESET / ETIMEDOUT）时自动退避重试。
# 这些是纯重试参数，不改变任何解析结果，对 CI 与官方源同样安全。
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
network-timeout=300000