# API 服务端口（规约：3080；禁止 3081）
PORT=3080

# 数据库（docker-compose 默认值）
DATABASE_URL=postgresql://smarthome:smarthome@localhost:5432/smarthome?schema=public

# Redis（队列/缓存）
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 跨域来源（前端 dev 5173）
CORS_ORIGIN=http://localhost:5173


# ============================================================
# 模型配置（开源自部署核心：本地大模型 + 云端大模型自由组合）
# 对话走 OpenAI 兼容协议，生图支持 MiniMax/OpenAI/ComfyUI，生视频走 MiniMax Director
# 这里是"部署默认值"；部署后管理员可在前端「系统管理 - 模型配置」页在线编辑，
# 在线配置持久化数据库且优先于本文件（页面上点"恢复 .env 默认"才回退到这里）
# ============================================================

# —— 对话模型（LLM_*）：填任意 OpenAI 兼容端点即可 ——
# 不设置 LLM_* 时回退到下方 MiniMax_*（向后兼容）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=你的key
# LLM_MODEL=deepseek-chat        # 设置后全局锁定该模型；留空则跟随请求
#
# 常见云端 provider（base_url / 推荐 model / 获取 key）：
#   DeepSeek    https://api.deepseek.com                     deepseek-chat / deepseek-reasoner   https://platform.deepseek.com/api_keys
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus / qwen-max              阿里云百炼控制台
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4         glm-4-plus                          https://open.bigmodel.cn
#   Kimi 月之暗面 https://api.moonshot.cn/v1                   moonshot-v1-8k                      https://platform.moonshot.cn
#   OpenAI      https://api.openai.com/v1                    gpt-4o-mini                         https://platform.openai.com/api-keys
#   MiniMax     https://api.minimaxi.com/v1                  MiniMax-M3                          https://platform.minimaxi.com
#
# 本地大模型（同样 OpenAI 兼容，填本机地址、key 随意填占位串）：
#   Ollama      http://localhost:11434/v1                    qwen3 / llama3.2 …（ollama pull 后）  安装：https://ollama.com/download
#   LM Studio   http://localhost:1234/v1                     界面内已加载的模型名                    安装：https://lmstudio.ai
#   vLLM        http://localhost:8000/v1                     启动时指定的 served-model-name         https://docs.vllm.ai

# —— 生图（IMAGE_PROVIDER=minimax | openai | comfyui，默认 minimax）——
# minimax：用下方 MiniMax_API_KEY，模型 image-01
# openai：IMAGE_BASE_URL(默认 https://api.openai.com/v1) + IMAGE_API_KEY + IMAGE_MODEL(默认 gpt-image-1)
# comfyui：本地 ComfyUI 出图，需 COMFYUI_BASE_URL + 导出 API 格式工作流到 COMFYUI_WORKFLOW_PATH
# IMAGE_PROVIDER=minimax
# IMAGE_MODEL=image-01
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=replace-me
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=./comfyui-workflow.json
# COMFYUI_PROMPT_NODE=6        # 工作流里正向 CLIPTextEncode 节点 id
# COMFYUI_NEGATIVE_NODE=7      # 负向节点 id
# COMFYUI_LATENT_NODE=5        # EmptyLatentImage 节点 id（控制宽高）
# COMFYUI_SEED_NODE=3          # KSampler 节点 id（控制随机种子）

# —— 生视频：VIDEO_PROVIDER=minimax(默认, MiniMax Director T2V/I2V) | openai(Sora 2 videos API) ——
# minimax 复用下方 MiniMax_API_KEY；openai 走 OpenAI 平台 Key
# VIDEO_PROVIDER=openai
# VIDEO_BASE_URL=https://api.openai.com/v1
# VIDEO_API_KEY=你的OpenAI-key
# VIDEO_MODEL=sora-2

# MiniMax（对话/生图 minimax/生视频 minimax 的默认 provider）
MiniMax_BASE_URL=https://api.minimaxi.com/v1
MiniMax_API_KEY=replace-me
# 模型网关（LiteLLM，compose profile gateway 启动后可作为统一路由）
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-dev

# 本地文件存储（MinIO profile 启用前）
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# 扣费额度（token 记账单位，100 token = ¥1 仅为展示层口径）
# 开源自部署：按你自己的模型成本（本地 config UI 跑模型 / 云端大模型 API）自行调整，平台不预设商业定价
BILLING_CHAT_TOKENS=3
BILLING_IMAGE_TOKENS=300
BILLING_VIDEO_TOKENS=1500
BILLING_PLAN_TOKENS=100
BILLING_PLAN_PRIVATE_TOKENS=160

# 种子管理员（仅开发环境；生产 compose 强制要求显式设置，拒绝默认值启动）
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=Admin@123456

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:3080
