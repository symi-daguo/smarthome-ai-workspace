# API 服务端口（规约：3080；禁止 3081）
PORT=3080

# 数据库（docker-compose 默认值）
DATABASE_URL=postgresql://smarthome:smarthome@localhost:5432/smarthome?schema=public

# Redis（队列/缓存）
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 跨域来源（前端 dev 5173）
CORS_ORIGIN=http://localhost:5173


# MiniMax API（OpenAI 兼容协议，注入到 LiteLLM 网关）
# 启动前请填入真实 key
MiniMax_BASE_URL=https://api.minimaxi.com/v1
MiniMax_API_KEY=replace-me
# 模型网关（LiteLLM，compose profile gateway 启动后使用）
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-dev

# 本地文件存储（MinIO profile 启用前）
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# 扣费额度（token 记账单位，100 token = ¥1 仅为展示层口径）
# 开源自部署：按你自己的模型成本（本地 config UI 跑模型 / 云端大模型 API）自行调整，平台不预设商业定价
BILLING_CHAT_TOKENS=3
BILLING_IMAGE_TOKENS=300
BILLING_VIDEO_TOKENS=1500
BILLING_PLAN_TOKENS=100
BILLING_PLAN_PRIVATE_TOKENS=160

# 种子管理员（仅开发环境；生产 compose 强制要求显式设置，拒绝默认值启动）
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=Admin@123456

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:3080
