{
  "name": "smart-home-ai-saas",
  "version": "0.2.5",
  "private": true,
  "description": "智能家居 AI 工作台：多租户、RBAC、agent 工具调用、内容提取与知识库（开源自部署，模型自选）",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter @app/api smoke",
    "db:migrate": "pnpm --filter @app/api prisma:migrate",
    "db:seed": "pnpm --filter @app/api prisma:seed",
    "docker:prune": "docker image prune -f && docker builder prune -af --filter \"until=24h\"",
    "ops:check": "bash scripts/ops-check.sh"
  }
}
